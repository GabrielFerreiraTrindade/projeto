# Banco de dados (PostgreSQL)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pneus_ecommerce?schema=public"

# Aplicação
NEXT_PUBLIC_SITE_NAME="PneuMinas"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Autenticação (assinatura do cookie de sessão) — gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-um-valor-aleatorio"

# Pagamento — ver PAYMENT_SETUP.md para como obter cada valor.
# Gateway ativo: "pagarme" (cartão + Pix) ou "payonpag" (só Pix — ver seção 9
# de PAYMENT_SETUP.md). "mercadopago" e "picpay" existem como estrutura
# pronta para o futuro, mas ainda não têm implementação real (ver
# src/lib/payment/providers/).
PAYMENT_PROVIDER=pagarme

# Chave secreta da conta Pagar.me — NUNCA exponha no frontend nem versione
# com um valor real.
PAGARME_API_KEY=

# Chave pública da conta Pagar.me — esta é enviada ao navegador de propósito
# (é assim que a tokenização de cartão funciona), por isso o prefixo
# NEXT_PUBLIC_. Mesmo assim, nunca é a chave secreta.
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# Credenciais de Basic Auth configuradas na URL do webhook, no painel do
# Pagar.me (é o único mecanismo de autenticidade de webhook que eles
# documentam — não existe assinatura HMAC).
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=

# Chave de API da conta PayOnPag (só usada se PAYMENT_PROVIDER=payonpag).
PAYONPAG_API_SECRET=

# Segredo nosso (qualquer valor aleatório forte, defina você mesmo) embutido
# na query string da webhook_url que enviamos ao PayOnPag em cada
# transação — é assim que autenticamos o webhook deles, já que não existe
# assinatura documentada.
PAYONPAG_WEBHOOK_SECRET=

# Quantidade máxima de parcelas oferecida no checkout. O valor de cada
# parcela (com ou sem juros) é calculado pela conta Pagar.me, não por nós.
NEXT_PUBLIC_MAX_INSTALLMENTS=12
