# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example nunca tem segredo real (só nomes de variável e instruções) —
# vale versionar pra quem for configurar o projeto do zero.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# armazenamento local mock de autenticação (contém dados de usuários)
/.data

# estado local e config da ferramenta Claude Code (não é conteúdo do
# projeto - fica só na máquina de quem usa a ferramenta)
/.claude/
CLAUDE.md
AGENTS.md
